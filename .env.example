# =============================================================================
# TrendPulse MVP - Environment Variables
# =============================================================================
# Copy to .env and fill in your credentials.
# Reddit/X no longer use API credentials — scraper/run_scraper.py logs into
# both via a real browser session instead (see scraper/README or the repo's
# recent commit history for the login workflow).

# -----------------------------------------------------------------------------
# Telegram source - OPTIONAL
# -----------------------------------------------------------------------------
# No login needed — public channels only. Comma-separated channel usernames,
# no @ prefix (e.g. "wallstreetbets,cryptosignals"). Leave empty to skip.
TELEGRAM_CHANNELS=

# -----------------------------------------------------------------------------
# Alerts - OPTIONAL (add one or both)
# -----------------------------------------------------------------------------

# Discord Webhook
# Create at: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Resend Email (free: 3k emails/month)
# Get API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx
ALERT_EMAIL=your@email.com

# -----------------------------------------------------------------------------
# Scraper - OPTIONAL
# -----------------------------------------------------------------------------
# Seconds between scan cycles (default 300 = 5 min)
SCRAPE_INTERVAL_SECONDS=300
