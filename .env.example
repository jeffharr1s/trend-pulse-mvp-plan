# =============================================================================
# TrendPulse MVP - Environment Variables
# =============================================================================
# Copy to .env and fill in your credentials
# For Vercel: Add these in Project Settings > Environment Variables

# -----------------------------------------------------------------------------
# Reddit API (PRAW) - REQUIRED
# -----------------------------------------------------------------------------
# Get credentials at: https://www.reddit.com/prefs/apps
# Create app type: "script"
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# -----------------------------------------------------------------------------
# Phase 2: Alerts - OPTIONAL (add one or both)
# -----------------------------------------------------------------------------

# Discord Webhook
# Create at: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Resend Email (free: 3k emails/month)
# Get API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx
ALERT_EMAIL=your@email.com

# -----------------------------------------------------------------------------
# Phase 3: Trading - Coming Soon
# -----------------------------------------------------------------------------
# ALPACA_API_KEY=your_alpaca_key
# ALPACA_SECRET_KEY=your_alpaca_secret
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
